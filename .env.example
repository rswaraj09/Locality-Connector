# Locality Connector - environment template.
# Copy to `.env` and fill in real values. NEVER commit the real .env file.

# --- Security (required) ---
# HMAC-SHA256 signing secret for JWTs. MUST be at least 32 characters (256 bits).
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# Comma-separated emails that are granted the ADMIN role on login.
ADMIN_EMAILS=

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- MongoDB (required) ---
# MongoDB Atlas connection URI or local MongoDB URI.
# IMPORTANT: The database name (e.g., /locality_connector) MUST be included in the URI path.
# Without it, Spring Data MongoDB will fail with "Database name must not be empty".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/locality_connector?retryWrites=true&w=majority

# --- Server ---
SERVER_PORT=8081
APP_LOG_LEVEL=INFO

# --- Resend.com Email (optional; falls back to console logging if not set) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Fast2SMS API (optional; for sending real SMS OTPs in India) ---
FAST2SMS_API_KEY=

# --- Google Maps (optional; only needed for geocoding / nearby search) ---
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODING_API_KEY=
