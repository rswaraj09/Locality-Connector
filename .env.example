# Locality Connector - environment template.
# Copy to `.env` and fill in real values. NEVER commit the real .env file.

# --- Deployment profile (required) ---
# "prod" enforces Secure cookies and hides internal error detail from clients.
# Only use "dev" for local HTTP-only development.
SPRING_PROFILES_ACTIVE=prod

# --- Security (required) ---
# HMAC-SHA256 signing secret for JWTs. MUST be at least 32 characters (256 bits).
# Generate one with: openssl rand -base64 48
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# Comma-separated emails that are granted the ADMIN role on login.
ADMIN_EMAILS=

# Comma-separated list of allowed CORS origins. Set this to your real frontend
# origin(s) in production (e.g. https://app.yourdomain.com) - do not leave it
# pointed at localhost once deployed.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Cookies are Secure-only by default in the prod profile. Leave this unset/true
# once you're behind HTTPS on AWS; only set to false for plain-HTTP local testing
# outside the dev profile.
COOKIE_SECURE=true

# Public base URL of this deployment (used to build links in emails and uploaded
# file URLs). Set this to your real domain, e.g. https://api.yourdomain.com.
APP_BASE_URL=http://localhost:8081

# --- MongoDB (required) ---
# MongoDB Atlas connection URI or local MongoDB URI.
# IMPORTANT: The database name (e.g., /locality_connector) MUST be included in the URI path.
# Without it, Spring Data MongoDB will fail with "Database name must not be empty".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/locality_connector?retryWrites=true&w=majority

# --- Server ---
SERVER_PORT=8081
APP_LOG_LEVEL=INFO

# --- File uploads ---
# Local disk storage only survives on a single, persistent instance. If you run
# more than one container/task on AWS (ECS/Fargate with 2+ tasks, or any
# auto-scaled setup), local disk is NOT shared between instances and uploaded
# images will be missing on whichever instance didn't receive the upload.
# For a multi-instance AWS deployment, move StorageService to Amazon S3 instead
# of ./uploads before going live with more than one task.
UPLOAD_DIR=./uploads

# --- Resend.com Email (optional; falls back to console logging if not set) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Fast2SMS API (optional; for sending real SMS OTPs in India) ---
FAST2SMS_API_KEY=

# --- Twilio API (optional; $15.50 free trial for real SMS globally) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# --- Cloudinary Image CDN (optional; falls back to local storage if not set) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- Google Maps (optional; only needed for geocoding / nearby search) ---
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODING_API_KEY=
